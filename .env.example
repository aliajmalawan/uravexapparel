# ---------------------------------------------------------------------------
# URAVEX Apparel — environment template. PLACEHOLDERS ONLY.
# Copy to .env (php bin/console.php setup creates it with generated secrets).
# Never commit .env. Nothing here is sent to the browser.
# ---------------------------------------------------------------------------

# development | production
APP_ENV=development
APP_DEBUG=true
# Public base URL, no trailing slash. XAMPP: http://localhost/uravexapparel
APP_URL=http://localhost/uravexapparel
# 64 random hex chars (php -r "echo bin2hex(random_bytes(32));")
APP_KEY=CHANGE_ME

BUSINESS_TIMEZONE=Asia/Karachi
DEFAULT_CURRENCY=PKR
# Number of trusted reverse proxies in front of the app (0 = none).
TRUSTED_PROXY_HOPS=0

# MySQL / MariaDB (MySQLi). Production: a least-privilege user, never root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uravexapparel
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
# Separate database used by the automated tests (it is wiped on every run).
DB_TEST_DATABASE=uravexapparel_test

# Email — MAIL_DRIVER: outbox (dev: writes files to storage/mail) | smtp
MAIL_DRIVER=outbox
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="URAVEX Apparel"
# Staff inbox for new-order / payment alerts (optional)
MAIL_ADMIN_NOTIFY=
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS) | ssl (implicit TLS, usually 465) | none
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# Payments. PAYMENT_MODE: sandbox | live
PAYMENT_MODE=sandbox
# Development-only simulated gateway (disabled automatically in production)
SANDBOX_WEBHOOK_SECRET=CHANGE_ME

# Official provider credentials — only after merchant approval. Adapters are
# not active until implemented against the provider's official API docs.
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# Secret for POST /cron/run (or use the CLI: php bin/console.php cron)
CRON_SECRET=CHANGE_ME

# Upload limits (bytes)
UPLOAD_MAX_IMAGE_BYTES=8388608
UPLOAD_MAX_RECEIPT_BYTES=5242880
