# Uploaded media: images only, never executable.
# Kept to directives every shared host allows (no Options -ExecCGI / php_flag,
# which some cPanel/LiteSpeed servers reject with a 500 for the whole folder).
Options -Indexes

# Scripts and active content are never served from here (so they can't run).
<FilesMatch "(?i)\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|svg|js)$">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "public, max-age=2592000"
</IfModule>
